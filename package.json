{
  "name": "effectstore",
  "version": "1.0.1",
  "description": "LiveFlow - Premium Livestream Effects Manager",
  "main": "desktop/main.js",
  "scripts": {
    "start": "npm --prefix desktop start",
    "dev": "concurrently \"npm --prefix backend start\" \"npm --prefix desktop start\"",
    "desktop": "npm --prefix desktop start",
    "build": "npm run release:check && npm --prefix desktop run build",
    "build:verify": "npm run release:check && npm --prefix desktop run build:verify",
    "release:windows": "npm run test && npm run release:check && npm --prefix desktop run build -- --publish never",
    "release:upload": "node scripts/upload-release.js",
    "test": "npm --prefix backend test && node scripts/validate-localization.js",
    "backend": "npm --prefix backend start",
    "release:check": "node scripts/validate-release.js"
  },
  "keywords": [
    "electron",
    "obs",
    "tiktok",
    "live",
    "effects"
  ],
  "author": "LiveFlow Team",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
