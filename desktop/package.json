{
  "name": "effectstore-desktop",
  "version": "1.0.3",
  "description": "LiveFlow - Premium Livestream Effects",
  "main": "main.js",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "build": "node scripts/build-win.js",
    "build:verify": "node scripts/build-win.js"
  },
  "author": "LiveFlow",
  "companyName": "LiveFlow",
  "copyright": "Copyright © 2026 LiveFlow",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "auto-launch": "^5.0.5",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "ws": "^8.16.0"
  },
  "build": {
    "appId": "com.effectstore.app",
    "productName": "LiveFlow",
    "icon": "assets/liveflow.ico",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "backend-manager.js",
      "diagnostics.js",
      "preload.js",
      "assets/**/*",
      "renderer/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!.env",
          "!uploads/**/*",
          "!public/uploads/**/*",
          "!effects/encrypted/**/*",
          "!public/assets/videos/**/*",
          "!public/assets/frames/**/*",
          "!assets/videos/**/*",
          "!tests/**/*",
          "!scripts/**/*",
          "!node_modules/**/*"
        ]
      },
      {
        "from": "../backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!nodemon/**/*",
          "!.bin/**/*",
          "!**/*.md",
          "!**/*.ts",
          "!**/*.map",
          "!**/*.d.ts",
          "!**/test/**/*",
          "!**/tests/**/*",
          "!**/docs/**/*",
          "!**/example/**/*",
          "!**/examples/**/*"
        ]
      },
      {
        "from": "../frontend/overlay",
        "to": "frontend/overlay"
      },
      {
        "from": "vendor/mongodb",
        "to": "mongodb"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/liveflow.ico",
      "artifactName": "LiveFlow-Setup-${version}.${ext}",
      "sign": "../backend/scripts/noop-sign.js"
    },
    "publish": {
      "provider": "generic",
      "url": "https://effectstore-app.onrender.com/updates/stable",
      "channel": "latest"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "installerIcon": "assets/liveflow.ico",
      "uninstallerIcon": "assets/liveflow.ico",
      "installerHeaderIcon": "assets/liveflow.ico"
    }
  }
}
