# Sao chép file này thành backend/.env và thay toàn bộ giá trị placeholder.
NODE_ENV=production
API_HOST=127.0.0.1
WS_HOST=127.0.0.1
PORT=9000
WS_PORT=9001
MONGODB_URI=mongodb://127.0.0.1:27017/effectstore
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Central server only: use an RSA PKCS#8 private key to issue RS256 user JWTs.
# Store this as a protected multiline secret; never package it with Electron.
# CLOUD_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Central server and desktop local backend: matching SPKI public key.
# CLOUD_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
CORS_ALLOWED_ORIGINS=
OBS_HOST=127.0.0.1
OBS_PORT=4455
OBS_PASSWORD=replace-with-obs-websocket-password
BANK_CODE=TCB
BANK_ACCOUNT_NUMBER=replace-with-account-number
BANK_ACCOUNT_NAME=replace-with-account-name
# Thanh toán hiện được Admin duyệt thủ công trong app.
# Chỉ cấu hình cả hai biến sau khi triển khai và kiểm thử auto-approval riêng.
PAYMENT_AUTO_APPROVAL_ENABLED=false
# SEPAY_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
MAX_EFFECT_QUEUE_SIZE=500

# Khi backend chạy bên trong desktop, cấu hình được mã hóa bằng safeStorage và
# các đường dẫn dưới đây được Electron tự thiết lập.
# EFFECTSTORE_DATA_DIR=C:\Users\...\AppData\Roaming\effectstore-desktop\backend-data
# EFFECTSTORE_LEGACY_DATA_DIR=D:\old-effectstore\backend
