{
  "name": "effectstore-desktop",
  "version": "1.0.0",
  "description": "LiveFlow - Premium Livestream Effects",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:verify": "electron-builder --dir -c.win.signAndEditExecutable=false"
  },
  "author": "LiveFlow",
  "companyName": "LiveFlow",
  "copyright": "Copyright © 2026 LiveFlow",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "express": "^4.18.2",
    "ws": "^8.16.0",
    "auto-launch": "^5.0.5"
  },
  "build": {
    "appId": "com.effectstore.app",
    "productName": "LiveFlow",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "backend-manager.js",
      "diagnostics.js",
      "preload.js",
      "assets/**/*",
      "renderer/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!.env",
          "!uploads/**/*",
          "!tests/**/*",
          "!scripts/**/*",
          "!node_modules/.cache/**/*"
        ]
      },
      {
        "from": "../frontend/overlay",
        "to": "frontend/overlay"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "LiveFlow-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
